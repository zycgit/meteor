<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:meteor:test:extension" targetNamespace="urn:meteor:test:extension">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:meteor:test:extension">
            <xsd:complexType name="BaseRequest">
                <xsd:sequence>
                    <xsd:element name="base" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="NotifyRequest">
                <xsd:complexContent>
                    <xsd:extension base="tns:BaseRequest">
                        <xsd:sequence>
                            <xsd:element name="extra" type="xsd:string"/>
                        </xsd:sequence>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>
            <xsd:element name="notify" type="tns:NotifyRequest"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="NotifyMessage">
        <wsdl:part name="parameters" element="tns:notify"/>
    </wsdl:message>
    <wsdl:portType name="NotifyPortType">
        <wsdl:operation name="notify">
            <wsdl:input message="tns:NotifyMessage"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="NotifyBinding" type="tns:NotifyPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="notify">
            <soap:operation soapAction="urn:meteor:test:extension:notify"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="NotifyService">
        <wsdl:port name="NotifyPort" binding="tns:NotifyBinding">
            <soap:address location="http://127.0.0.1:1/notify"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
