<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:meteor:test:styles:dispatch"
                  targetNamespace="urn:meteor:test:styles:dispatch">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:meteor:test:styles:dispatch">
            <xsd:element name="key" type="xsd:string"/>
            <xsd:element name="text" type="xsd:string"/>
            <xsd:element name="number" type="xsd:int"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="TextRequest">
        <wsdl:part name="key" element="tns:key"/>
        <wsdl:part name="value" element="tns:text"/>
    </wsdl:message>
    <wsdl:message name="NumberRequest">
        <wsdl:part name="key" element="tns:key"/>
        <wsdl:part name="value" element="tns:number"/>
    </wsdl:message>
    <wsdl:portType name="DispatchPortType">
        <wsdl:operation name="storeText">
            <wsdl:input message="tns:TextRequest"/>
        </wsdl:operation>
        <wsdl:operation name="appendText">
            <wsdl:input message="tns:TextRequest"/>
        </wsdl:operation>
        <wsdl:operation name="storeNumber">
            <wsdl:input message="tns:NumberRequest"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="DispatchBinding" type="tns:DispatchPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="storeText">
            <soap:operation soapAction="urn:meteor:test:styles:dispatch:storeText"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
        </wsdl:operation>
        <wsdl:operation name="appendText">
            <soap:operation soapAction="urn:meteor:test:styles:dispatch:appendText"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
        </wsdl:operation>
        <wsdl:operation name="storeNumber">
            <soap:operation soapAction="urn:meteor:test:styles:dispatch:storeNumber"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="DispatchService">
        <wsdl:port name="DispatchPort" binding="tns:DispatchBinding">
            <soap:address location="http://127.0.0.1:1/placeholder/DispatchService"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
