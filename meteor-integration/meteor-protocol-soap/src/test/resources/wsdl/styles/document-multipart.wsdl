<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:meteor:test:styles:multipart"
                  targetNamespace="urn:meteor:test:styles:multipart">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:meteor:test:styles:multipart">
            <xsd:element name="firstName" type="xsd:string"/>
            <xsd:element name="lastName" type="xsd:string"/>
            <xsd:element name="fullName" type="xsd:string"/>
            <xsd:element name="length" type="xsd:int"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="CombineRequest">
        <wsdl:part name="first" element="tns:firstName"/>
        <wsdl:part name="last" element="tns:lastName"/>
    </wsdl:message>
    <wsdl:message name="CombineResponse">
        <wsdl:part name="result" element="tns:fullName"/>
        <wsdl:part name="size" element="tns:length"/>
    </wsdl:message>
    <wsdl:portType name="CombinePortType">
        <wsdl:operation name="combine">
            <wsdl:input message="tns:CombineRequest"/>
            <wsdl:output message="tns:CombineResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="CombineBinding" type="tns:CombinePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="combine">
            <soap:operation soapAction="urn:meteor:test:styles:multipart:combine"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="CombineService">
        <wsdl:port name="CombinePort" binding="tns:CombineBinding">
            <soap:address location="http://127.0.0.1:1/placeholder/CombineService"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
