<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="urn:meteor:test:styles:override"
        targetNamespace="urn:meteor:test:styles:override">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:meteor:test:styles:override">
            <xsd:element name="echoRequest" type="xsd:string"/>
            <xsd:element name="echoResult" type="xsd:string"/>
        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="EchoRequest">
        <wsdl:part name="parameters" element="tns:echoRequest"/>
    </wsdl:message>
    <wsdl:message name="EchoResponse">
        <wsdl:part name="parameters" element="tns:echoResult"/>
    </wsdl:message>

    <wsdl:portType name="EchoPortType">
        <wsdl:operation name="echo">
            <wsdl:input message="tns:EchoRequest"/>
            <wsdl:output message="tns:EchoResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="EchoBinding" type="tns:EchoPortType">
        <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="echo">
            <soap:operation style="document" soapAction="urn:meteor:test:styles:override:echo"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="EchoService">
        <wsdl:port name="EchoPort" binding="tns:EchoBinding">
            <soap:address location="http://127.0.0.1:1/placeholder/EchoService"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
