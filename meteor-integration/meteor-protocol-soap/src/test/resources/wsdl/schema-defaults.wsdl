<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:meteor:test:schema-defaults"
                  targetNamespace="urn:meteor:test:schema-defaults">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:meteor:test:schema-defaults">
            <xsd:element name="notify">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="label" type="xsd:string" default="fallback" nillable="true"/>
                        <xsd:element name="optional" type="xsd:string" default="optional-default" minOccurs="0"/>
                    </xsd:sequence>
                    <xsd:attribute name="mode" type="xsd:string" default="standard"/>
                    <xsd:attribute name="version" type="xsd:int" fixed="3"/>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="NotifyRequest"><wsdl:part name="parameters" element="tns:notify"/></wsdl:message>
    <wsdl:portType name="NotifyPortType">
        <wsdl:operation name="notify"><wsdl:input message="tns:NotifyRequest"/></wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="NotifyBinding" type="tns:NotifyPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="notify">
            <soap:operation soapAction="urn:meteor:test:schema-defaults:notify"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="NotifyService">
        <wsdl:port name="NotifyPort" binding="tns:NotifyBinding">
            <soap:address location="http://127.0.0.1:1/notify"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
