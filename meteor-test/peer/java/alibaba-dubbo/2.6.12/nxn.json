{
  "schemaVersion": 1,
  "endpoints": [
    {
      "id": "java-alibaba-dubbo-2-6",
      "language": "java",
      "implementation": "Alibaba Dubbo",
      "runtimeManifestProperty": "meteor.test.sdk.manifest",
      "launch": {
        "provider": {
          "container": "java",
          "command": [
            "java",
            "--add-opens=java.base/java.io=ALL-UNNAMED",
            "--add-opens=java.base/java.lang=ALL-UNNAMED",
            "-cp",
            "${classpath}",
            "net.hasor.peer.sdk.${entry}.SdkProviderMain"
          ]
        },
        "consumer": {
          "container": "java",
          "command": [
            "java",
            "--add-opens=java.base/java.io=ALL-UNNAMED",
            "--add-opens=java.base/java.lang=ALL-UNNAMED",
            "-cp",
            "${classpath}",
            "net.hasor.peer.sdk.${entry}.SdkConsumerMain"
          ]
        }
      },
      "capabilities": [
        {
          "id": "java-sdk-dubbo-classic",
          "api": "order-v1",
          "protocol": "dubbo",
          "protocolVersion": "2",
          "wire": "dubbo-hessian2-tcp-clear",
          "roles": [
            "provider",
            "consumer"
          ],
          "discoveries": [
            "direct"
          ],
          "runtimeProfile": "dubboClassic",
          "entry": "dubbo"
        }
      ]
    }
  ]
}
