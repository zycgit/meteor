{
  "schemaVersion": 1,
  "endpoints": [
    {
      "id": "java-caucho-hessian",
      "language": "java",
      "implementation": "Caucho Hessian",
      "runtimeManifestProperty": "meteor.test.sdk.manifest",
      "launch": {
        "provider": {
          "container": "java",
          "command": [
            "java",
            "--add-opens=java.base/java.io=ALL-UNNAMED",
            "--add-opens=java.base/java.lang=ALL-UNNAMED",
            "-cp",
            "${classpath}",
            "net.hasor.peer.sdk.${entry}.SdkProviderMain"
          ]
        },
        "consumer": {
          "container": "java",
          "command": [
            "java",
            "--add-opens=java.base/java.io=ALL-UNNAMED",
            "--add-opens=java.base/java.lang=ALL-UNNAMED",
            "-cp",
            "${classpath}",
            "net.hasor.peer.sdk.${entry}.SdkConsumerMain"
          ]
        }
      },
      "capabilities": [
        {
          "id": "java-sdk-hessian-legacy",
          "api": "order-v1",
          "protocol": "hessian",
          "protocolVersion": "2",
          "wire": "hessian2-http1-clear",
          "roles": [
            "provider",
            "consumer"
          ],
          "discoveries": [
            "direct"
          ],
          "runtimeProfile": "hessianLegacy",
          "entry": "hessian"
        },
        {
          "id": "java-sdk-hessian-recent",
          "api": "order-v1",
          "protocol": "hessian",
          "protocolVersion": "2",
          "wire": "hessian2-http1-clear",
          "roles": [
            "provider",
            "consumer"
          ],
          "discoveries": [
            "direct"
          ],
          "runtimeProfile": "hessianRecent",
          "entry": "hessian"
        }
      ]
    }
  ]
}
