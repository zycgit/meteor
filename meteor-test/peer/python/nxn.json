    {
      "id": "python-connect",
      "language": "python",
      "implementation": "Connect Python",
      "launch": {
        "provider": {
          "container": "python",
          "command": [
            "/opt/meteor-peer/python-connect/bin/python",
            "${project}/connect/peer.py",
            "provider",
            "--protocol",
            "${protocol}",
            "--generated",
            "/opt/meteor-peer/python-connect-generated"
          ]
        },
        "consumer": {
          "container": "python",
          "command": [
            "/opt/meteor-peer/python-connect/bin/python",
            "${project}/connect/peer.py",
            "consumer",
            "--protocol",
            "${protocol}",
            "--generated",
            "/opt/meteor-peer/python-connect-generated"
          ]
        }
      },
      "capabilities": [
        {
          "id": "connect-default",
          "api": "order-v1",
          "protocol": "connect",
          "protocolVersion": "1",
          "wire": "connect-protobuf-http1-clear",
          "roles": [
            "provider",
            "consumer"
          ],
          "discoveries": [
            "direct"
          ]
        },
        {
          "id": "grpc-web-default",
          "api": "order-v1",
          "protocol": "grpc-web",
          "protocolVersion": "",
          "wire": "grpc-web-protobuf-http1-clear",
          "roles": [
            "provider",
            "consumer"
          ],
          "discoveries": [
            "direct"
          ]
        }
      ]
    }
  ]
