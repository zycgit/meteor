{
  "schemaVersion": 1,
  "endpoints": [
    {
      "id": "python-grpc",
      "language": "python",
      "implementation": "grpcio",
      "launch": {
        "provider": {
          "container": "python",
          "command": [
            "/opt/meteor-peer/python-grpc/bin/python",
            "${project}/grpc/provider.py"
          ]
        },
        "consumer": {
          "container": "python",
          "command": [
            "/opt/meteor-peer/python-grpc/bin/python",
            "${project}/grpc/consumer.py"
          ]
        }
      },
      "capabilities": [
        {
          "id": "grpc-default",
          "api": "order-v1",
          "protocol": "grpc",
          "protocolVersion": "",
          "wire": "grpc-protobuf-http2-clear",
          "roles": [
            "provider",
            "consumer"
          ],
          "discoveries": [
            "direct"
          ]
        }
      ]
    },
    {
