<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="urn:meteor:test:fields"
        targetNamespace="urn:meteor:test:fields">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:meteor:test:fields" elementFormDefault="unqualified">
            <xsd:element name="finalResult" type="xsd:string"/>
            <xsd:element name="combine">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="plain" type="xsd:string"/>
                        <xsd:element name="qualified" type="xsd:string" form="qualified"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="combineResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element ref="tns:finalResult"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="CombineRequest">
        <wsdl:part name="parameters" element="tns:combine"/>
    </wsdl:message>
    <wsdl:message name="CombineResponse">
        <wsdl:part name="parameters" element="tns:combineResponse"/>
    </wsdl:message>
    <wsdl:portType name="FieldPortType">
        <wsdl:operation name="combine">
            <wsdl:input message="tns:CombineRequest"/>
            <wsdl:output message="tns:CombineResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="FieldBinding" type="tns:FieldPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="combine">
            <soap:operation soapAction="urn:meteor:test:fields:combine"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="FieldService">
        <wsdl:port name="FieldPort" binding="tns:FieldBinding">
            <soap:address location="http://127.0.0.1:1/placeholder/FieldService"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
